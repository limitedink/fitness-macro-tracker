# Optional. Leave this alone to keep data in the browser's local storage, which
# is the default and needs no server at all.
#
# Set VITE_API_URL to switch the whole app over to the REST backend instead.
# `./run --server` sets it to /api and proxies that to the API on :5001.
# VITE_API_URL=/api

# Optional: point the dev proxy at a backend on a different port.
# VITE_API_PROXY=http://localhost:5001
